# ===============================================
# MYUP BACKEND SERVER (.env sozlamalari)
# ===============================================

# Server porti va muhiti
PORT=5000
NODE_ENV=production

# 1-variant: Mahalliy yoki EC2 ichidagi PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sizning_postgres_parolingiz
DB_NAME=amaps_db
DB_SSL=false

# 2-variant: AWS RDS yoki Bulutli baza uchun (agar URL bo'lsa)
# DATABASE_URL=postgresql://username:password@rds-endpoint.amazonaws.com:5432/amaps_db?sslmode=require

# JWT Tokin xavfsizlik kaliti (istalgan uzun sirli matn)
JWT_SECRET=myup_prod_secret_token_key_change_me_2026
