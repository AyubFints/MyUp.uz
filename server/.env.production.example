# ===============================================
# MYUP PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# ===============================================

# Node Environment & Server Port
NODE_ENV=production
PORT=5000

# Security: Set a cryptographically secure random secret (min 32 characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars_long

# Allowed CORS origins (comma-separated list without trailing slashes)
# Allow main user frontend and admin panel domains
CORS_ORIGIN=https://myup.uz,https://www.myup.uz,https://admin.myup.uz

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=myup_user
DB_PASSWORD=strong_postgres_password_here
DB_NAME=myup_prod_db
DB_SSL=false

# If using AWS RDS, Supabase, Neon or managed cloud PostgreSQL:
# DATABASE_URL=postgresql://myup_user:password@cloud-db-host:5432/myup_prod_db?sslmode=require
# DB_SSL=true

# Connection Pool Tuning (Per PM2 worker process)
# Formula: Total DB connections = PM2_INSTANCES * DB_POOL_MAX <= postgresql max_connections - 15
DB_POOL_MAX=10

# API Rate Limiting Settings
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
