# ========================================================
# NGINX KONFIGURATSIYASI (AWS EC2 / Ubuntu uchun)
# Joylashuvi: /etc/nginx/sites-available/myup
# ========================================================

# 1-holat: Backend API va Frontend bitta serverda bo'lganda
server {
    listen 80;
    server_name myup.uz www.myup.uz api.myup.uz;

    # Katta hajmdagi rasmlar yuklashga ruxsat
    client_max_body_size 50M;

    # A) API so'rovlari Node.js ga yo'naltiriladi
    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # B) Frontend (React SPA fayllari)
    location / {
        root /var/www/myup/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
